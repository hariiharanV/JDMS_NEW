{
  "realm": "jdms-local",
  "displayName": "JDMS Next (local development)",
  "loginTheme": "jdms",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "en",
    "ar"
  ],
  "defaultLocale": "en",
  "roles": {
    "realm": [
      {
        "name": "MAKER",
        "description": "Uploads and indexes documents"
      },
      {
        "name": "CHECKER",
        "description": "Approves or rejects documents, metadata changes and deletions"
      },
      {
        "name": "COMMITTEE_MEMBER",
        "description": "Votes on items routed to a committee stage"
      },
      {
        "name": "VIEWER",
        "description": "Searches and views documents within scope"
      },
      {
        "name": "RECORDS_OFFICER",
        "description": "Manages retention policies, legal holds and disposition"
      },
      {
        "name": "TENANT_ADMIN",
        "description": "Manages cabinets, document types, fields, LOVs and workflow assignment"
      },
      {
        "name": "SECURITY_ADMIN",
        "description": "Manages roles, access rules, user branch scope and clearance"
      },
      {
        "name": "INTEGRATION_CLIENT",
        "description": "Bank system calling the integration API"
      },
      {
        "name": "MIGRATION",
        "description": "Legacy JDMS migration client (ADR-0020)"
      }
    ]
  },
  "clients": [
    {
      "clientId": "jdms-web",
      "name": "JDMS Next web application",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5180/*",
        "${JDMS_WEB_PUBLIC_URL}/*"
      ],
      "webOrigins": [
        "http://localhost:5180",
        "${JDMS_WEB_PUBLIC_URL}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5180/*##${JDMS_WEB_PUBLIC_URL}/*"
      },
      "protocolMappers": [
        {
          "name": "tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant",
            "claim.name": "tenant",
            "jsonType.label": "String",
            "multivalued": "false",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "branch_scope",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "branch_scope",
            "claim.name": "branch_scope",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "home_branch",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "home_branch",
            "claim.name": "home_branch",
            "jsonType.label": "String",
            "multivalued": "false",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "clearance",
