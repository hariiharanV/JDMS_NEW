# Local development settings for deploy/docker-compose.yml and `mvn spring-boot:run -Dspring-boot.run.profiles=local`.
# Copy to deploy/.env (git-ignored) and replace every CHANGE_ME. Never commit deploy/.env.
#   cp deploy/.env.example deploy/.env
# To use the same values when running the core locally:
#   set -a; . deploy/.env; set +a

# PostgreSQL (JDMS Next core database). The owner runs the migrations; the core and the worker connect as the
# application user, which cannot change or delete audit rows (ADR-0018). Use two different passwords.
JDMS_DB_NAME=jdms
JDMS_DB_OWNER_USERNAME=jdms
JDMS_DB_OWNER_PASSWORD=CHANGE_ME
JDMS_DB_USERNAME=jdms_app
JDMS_DB_PASSWORD=CHANGE_ME
JDMS_DB_PORT=5432

# Keycloak bootstrap administrator (local only)
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
KEYCLOAK_PORT=8180

# Network access (optional; deploy/tls/README.md). Without these the stack is reachable from this machine only.
# Browsers sign in over HTTPS only away from localhost, so a local certificate is needed:
# run deploy/tls/make-local-cert.sh <this machine's IP or name> and paste the lines it prints here.

# SeaweedFS S3 gateway credentials (local only)
JDMS_S3_ACCESS_KEY=CHANGE_ME
JDMS_S3_SECRET_KEY=CHANGE_ME
S3_PORT=8333

# Other service ports on the host (all bound to 127.0.0.1)
OPENSEARCH_PORT=9200
CLAMAV_PORT=3310
TIKA_PORT=9998
GOTENBERG_PORT=3300

# Keycloak realm jdms-local (local only): password for all dev users (maker1, checker1, viewer1, records1,
# tenantadmin1, secadmin1, bank2user1) and the secret of the jdms-integration-test client
JDMS_DEV_USER_PASSWORD=CHANGE_ME
JDMS_INTEGRATION_TEST_CLIENT_SECRET=CHANGE_ME
# Secret of the jdms-migration client (legacy migration tool, ADR-0020)
JDMS_MIGRATION_CLIENT_SECRET=CHANGE_ME
# Tag beside the wordmark on the sign-in page (default "LOCAL DEVELOPMENT"); set it empty for no tag
#JDMS_ENV_LABEL=LOCAL DEVELOPMENT

# Local KMS stub master key (PoC only): base64 of 32 random bytes, e.g. `openssl rand -base64 32`.
# Losing it makes stored documents unreadable; never commit it.
JDMS_LOCAL_KMS_MASTER_KEY=CHANGE_ME
